{
  "name": "abroad-consultancy-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "cd server && npm run dev",
    "build": "tsc && vite build",
    "postbuild": "node scripts/generate-seo.mjs && node scripts/finalize-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.config.frontend.ts",
    "test:ui:watch": "vitest --config vitest.config.frontend.ts",
    "verify:quick": "npm run typecheck && npm run lint",
    "verify": "npm run verify:quick && npm run test:ui && npm test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.58.0",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.30",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.3.5",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
